{
	debug

	log {
		output stdout
	}
}

geoffjay.local:8080 {
	encode gzip

	#handle {
	root * /usr/share/caddy
	file_server
	try_files {path} /index.html
	#}
}

api.geoffjay.local {
	encode gzip
	tls {
		protocols tls1.3
	}

	reverse_proxy * {
		to localhost:8082
		header_up Host {upstream_hostport}
	}
}
